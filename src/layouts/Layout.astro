        <svg viewBox="0 0 60 90" fill="none" xmlns="http://www.w3.org/2000/svg"><ellipse cx="30" cy="74" rx="10" ry="7" stroke="currentColor" stroke-width="2.2"/><line x1="30" y1="67" x2="8" y2="12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="30" y1="67" x2="18" y2="9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="30" y1="67" x2="30" y2="8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="30" y1="67" x2="42" y2="9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="30" y1="67" x2="52" y2="12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M7 26 Q30 34 53 26" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/><path d="M5 44 Q30 52 55 44" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg>
      </div>
      <div class="deco" data-speed="0.25" data-rotate="50" style="right:0%;top:85vh;width:55px;color:var(--primary)">
        <svg viewBox="0 0 80 160" fill="none" xmlns="http://www.w3.org/2000/svg"><ellipse cx="40" cy="55" rx="36" ry="50" stroke="currentColor" stroke-width="2.5"/><line x1="8" y1="34" x2="72" y2="34" stroke="currentColor" stroke-width="1" opacity="0.6"/><line x1="5" y1="47" x2="75" y2="47" stroke="currentColor" stroke-width="1" opacity="0.6"/><line x1="5" y1="60" x2="75" y2="60" stroke="currentColor" stroke-width="1" opacity="0.6"/><line x1="5" y1="73" x2="75" y2="73" stroke="currentColor" stroke-width="1" opacity="0.6"/><line x1="8" y1="86" x2="72" y2="86" stroke="currentColor" stroke-width="1" opacity="0.6"/><line x1="20" y1="7" x2="20" y2="103" stroke="currentColor" stroke-width="1" opacity="0.6"/><line x1="32" y1="5" x2="32" y2="105" stroke="currentColor" stroke-width="1" opacity="0.6"/><line x1="44" y1="5" x2="44" y2="105" stroke="currentColor" stroke-width="1" opacity="0.6"/><line x1="56" y1="5" x2="56" y2="105" stroke="currentColor" stroke-width="1" opacity="0.6"/><line x1="68" y1="7" x2="68" y2="103" stroke="currentColor" stroke-width="1" opacity="0.6"/><path d="M28 100 L40 112 L52 100" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/><line x1="40" y1="112" x2="40" y2="156" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></svg>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-grid">
        <div class="footer-brand">
          <p>Free, inclusive badminton workshops for all ages in NC. Building skills, confidence, and community.</p>
          <div class="footer-social">
            <a href="https://www.instagram.com/rookie_rackets" target="_blank" rel="noopener" aria-label="Instagram" class="social-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="mailto:teamrookierackets@gmail.com" aria-label="Email" class="social-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </a>
          </div>
        </div>
        <div class="footer-col">
          <h4>Pages</h4>
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/events">Upcoming Events</a>
          <a href="/completed-events">Completed Events</a>
          <a href="/faq">FAQ</a>
          <a href="/contact">Contact</a>
        </div>
        <div class="footer-col">
          <h4>Contact</h4>
          <a href="mailto:teamrookierackets@gmail.com">teamrookierackets@gmail.com</a>
          <a href="tel:+14142462382">414-246-2382</a>
          <span>Cary, NC 27519</span>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Rookie Rackets &bull; All rights reserved</p>
        <button class="scroll-top" id="scroll-top" aria-label="Scroll to top">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
        </button>
      </div>
