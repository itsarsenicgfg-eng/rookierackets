  </body>
</html>

<script>
  // ── Observers (created once, reused across navigations) ──
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

  function runCounter(el: Element) {
    const target = parseInt((el as HTMLElement).dataset.target ?? '0');
    const suffix = (el as HTMLElement).dataset.suffix ?? '';
    const duration = 1800;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 4);
      el.textContent = Math.round(eased * target) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        runCounter(entry.target);
        counterObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  // ── Per-page init (re-runs after every View Transition) ──
  function init() {
    // Nav scroll shrink
    const header = document.getElementById('site-header');
    const onScroll = () => {
      header?.classList.toggle('scrolled', window.scrollY > 40);
      document.getElementById('scroll-top')?.classList.toggle('visible', window.scrollY > 400);
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // Hamburger menu
    const toggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.classList.toggle('open', !open);
      mobileMenu?.classList.toggle('open', !open);
    });

    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.classList.remove('open');
        mobileMenu.classList.remove('open');
      });
    });

    // Scroll-to-top
    document.getElementById('scroll-top')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Observe reveal + counter elements on the new page
    document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
    document.querySelectorAll('.counter').forEach(el => counterObserver.observe(el));

    // Parallax decorators
    const decos = document.querySelectorAll<HTMLElement>('.deco');
    let rafId = 0;
    const runParallax = () => {
      const y = window.scrollY;
      decos.forEach(el => {
        const speed = parseFloat(el.dataset.speed ?? '0');
        const rot = el.dataset.rotate ?? '0';
        el.style.transform = `translateY(${y * speed}px) rotate(${rot}deg)`;
      });
    };
    const onParallaxScroll = () => {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(runParallax);
    };
    window.addEventListener('scroll', onParallaxScroll, { passive: true });
    runParallax();
  }

  // Runs on first load and after every client-side navigation
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    /* Palette — light theme */
    /* Surfaces: subtle lavender-tinted neutrals (no dead gray) */
    --bg:        #faf9fe;
    --s1:        #f8f7fd;
    --s2:        #f3f2fb;
    --s3:        #e8e6f5;
    --s4:        #dbd7ef;
    --border:    rgba(100,90,200,0.1);
    --border-md: rgba(100,90,200,0.18);

    --primary:      #7568f0;
    --primary-lt:   #9589ff;
    --primary-dk:   #5548cc;
    --primary-dim:  rgba(117,104,240,0.12);
    --primary-glow: rgba(117,104,240,0.22);

    --accent:       #f07830;
    --accent-lt:    #ff9048;
    --accent-dim:   rgba(240,120,48,0.12);
    --accent-glow:  rgba(240,120,48,0.18);

    --text:         #1a1a1a;
    --text-muted:   #1a1a1a;
    --text-subtle:  #333333;

    /* Typography */
    --font-display: 'Syne', system-ui, sans-serif;
    --font-body:    'Inter', system-ui, sans-serif;

    /* Geometry */
    --r-sm: 0.375rem;
    --r:    0.75rem;
    --r-lg: 1.25rem;
    --r-xl: 2rem;
    --max:  1120px;

    /* Shadows */
    --sh-sm: 0 2px 8px rgba(0,0,0,0.08);
    --sh:    0 8px 32px rgba(0,0,0,0.12);
    --sh-lg: 0 20px 60px rgba(0,0,0,0.16);
    --sh-glow-p: 0 0 40px rgba(117,104,240,0.18);
    --sh-glow-a: 0 0 40px rgba(240,120,48,0.14);
  }

  html {
    font-family: var(--font-body);
    color: var(--text);
    background: var(--bg);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* All sections white by default; footer and per-page overrides apply their own */
  section { background: #ffffff !important; }


  body { min-height: 100vh; display: flex; flex-direction: column; line-height: 1.6; font-weight: 400; }
  main { flex: 1; }

  a { color: var(--primary); text-decoration: none; }
  a:hover { text-decoration: underline; }
  img { max-width: 100%; height: auto; display: block; }

  h1, h2, h3, h4 { font-family: var(--font-display); color: var(--text); letter-spacing: -0.02em; line-height: 1.1; }
  h1 { font-size: clamp(2rem, 5vw, 3.75rem); font-weight: 800; }
  h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 700; }
  h3 { font-size: 1.05rem; font-weight: 700; }

  /* ── Header ──────────────────────────────────────────── */
  header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: rgba(255,255,255,0.96);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background 0.3s, padding 0.3s;
  }

  header.scrolled {
    background: rgba(255,255,255,0.995);
    border-color: var(--border);
  }

  .nav-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0.15rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: padding 0.3s;
  }

  header.scrolled .nav-inner { padding-top: 0.1rem; padding-bottom: 0.1rem; }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .logo:hover { text-decoration: none; }
  .logo { -webkit-tap-highlight-color: transparent; }

  .logo-img {
    width: auto;
    height: 104px;
    object-fit: contain;
    flex-shrink: 0;
    mix-blend-mode: multiply;
  }

  .logo-text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--text);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-logo-img {
    width: 72px;
    height: 72px;
    object-fit: contain;
    flex-shrink: 0;
    mix-blend-mode: multiply;
  }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .nav-links a {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.45rem 0.9rem;
    border-radius: var(--r-sm);
    transition: color 0.15s, background 0.15s;
  }

  .nav-links a:hover { color: var(--text); background: rgba(117,104,240,0.09); text-decoration: none; }
  .nav-links a.active { color: var(--text); background: rgba(117,104,240,0.13); }

  .nav-cta {
    background: var(--primary) !important;
    color: #fff !important;
    font-weight: 600 !important;
    border-radius: var(--r-sm) !important;
    box-shadow: 0 4px 16px var(--primary-glow) !important;
    transition: background 0.15s, transform 0.15s, box-shadow 0.15s !important;
  }

  .nav-cta:hover {
    background: var(--primary-lt) !important;
    transform: translateY(-1px) !important;
    box-shadow: 0 6px 24px var(--primary-glow) !important;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 11px;
    background: none;
    border: 1px solid var(--border-md);
    border-radius: var(--r-sm);
    cursor: pointer;
  }

  .hamburger span {
    display: block;
    height: 2px;
    background: var(--text-muted);
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.25s;
  }

  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s cubic-bezier(0.16,1,0.3,1);
    border-top: 1px solid transparent;
  }

  .mobile-menu.open {
    max-height: 400px;
    border-color: var(--border);
  }

  .mobile-menu ul {
    list-style: none;
    padding: 1rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-menu a {
    display: block;
    color: var(--text-muted);
