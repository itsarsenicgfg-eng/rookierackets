---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Rookie Rackets — free, inclusive badminton workshops for all ages in NC.' } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Rookie Rackets`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/IMG_7427.jpeg" />
    <meta property="og:site_name" content="Rookie Rackets" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Rookie Rackets`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/IMG_7427.jpeg" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | Rookie Rackets</title>
    <ViewTransitions />
    <script>document.documentElement.classList.add('js');</script>
  </head>
  <body>

    <header id="site-header">
      <nav class="nav-inner">
        <a href="/" class="logo" aria-label="Rookie Rackets — home">
          <img src="/images/logo-trim.png" alt="Rookie Rackets" class="logo-img" />
        </a>

        <ul class="nav-links">
          <li><a href="/" class={path === '/' ? 'active' : ''}>Home</a></li>
          <li><a href="/about" class={path === '/about' ? 'active' : ''}>About</a></li>
          <li><a href="/events" class={path === '/events' ? 'active' : ''}>Upcoming Events</a></li>
          <li><a href="/completed-events" class={path === '/completed-events' ? 'active' : ''}>Completed Events</a></li>
          <li><a href="/faq" class={path === '/faq' ? 'active' : ''}>FAQ</a></li>
          <li><a href="/contact" class="nav-cta">Sign Up</a></li>
        </ul>

        <button class="hamburger" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </nav>

      <div class="mobile-menu" id="mobile-menu">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/events">Upcoming Events</a></li>
          <li><a href="/completed-events">Completed Events</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact" class="mobile-cta">Sign Up →</a></li>
