---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection';
---

<Layout
  title="Home"
  description="Rookie Rackets — free, inclusive badminton workshops for youth in Cary, NC. Where birdies take flight."
>

  <!-- ╔══════════════════════════════════════╗ -->
  <!--   HERO (React component)               -->
  <!-- ╚══════════════════════════════════════╝ -->
  <HeroSection client:load />

  <!-- ╔══════════════════════════════════════╗ -->
  <!--   TICKER                                -->
  <!-- ╚══════════════════════════════════════╝ -->
  <div class="ticker-wrap">
    <div class="ticker-track">
      {Array(2).fill(null).map(() => (
        <span class="ticker-inner">
          <span class="ti">🏸 Free Workshops</span>
          <span class="td">·</span>
          <span class="ti">Youth of All Ages</span>
          <span class="td">·</span>
          <span class="ti">Cary, NC</span>
          <span class="td">·</span>
          <span class="ti">No Equipment Needed</span>
          <span class="td">·</span>
          <span class="ti">Trained by US National Coach</span>
          <span class="td">·</span>
          <span class="ti">30+ Tournaments Won</span>
          <span class="td">·</span>
          <span class="ti">Beginners Welcome</span>
          <span class="td">·</span>
        </span>
      ))}
    </div>
  </div>

  <!-- ╔══════════════════════════════════════╗ -->
  <!--   STATS                                 -->
  <!-- ╚══════════════════════════════════════╝ -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card reveal d1">
          <span class="stat-num counter" data-target="20" data-suffix="+">20+</span>
          <span class="stat-label">Years combined training</span>
          <div class="stat-bar"><div class="stat-fill" style="width:80%"></div></div>
        </div>
        <div class="stat-card stat-card-lit reveal d2">
          <span class="stat-num counter" data-target="30" data-suffix="+">30+</span>
          <span class="stat-label">Tournaments won</span>
          <div class="stat-bar"><div class="stat-fill" style="width:90%"></div></div>
        </div>
        <div class="stat-card reveal d3">
          <span class="stat-num counter" data-target="6" data-suffix="+">6+</span>
          <span class="stat-label">Years coaching beginners</span>
          <div class="stat-bar"><div class="stat-fill" style="width:60%"></div></div>
        </div>
        <div class="stat-card reveal d4">
          <span class="stat-num">100%</span>
          <span class="stat-label">Free for all participants</span>
          <div class="stat-bar"><div class="stat-fill" style="width:100%"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════╗ -->
  <!--   WHAT WE DO                            -->
  <!-- ╚══════════════════════════════════════╝ -->
  <section id="what-we-do" class="wwd">
    <div class="container">
      <div class="section-intro reveal">
        <span class="label">What We Do</span>
        <h2>More than a workshop.<br />A community.</h2>
        <p>Free badminton sessions for youth of all skill levels. Show up, play, and grow — no experience or equipment needed.</p>
      </div>

      <div class="wwd-grid">
        <div class="wwd-card reveal d1">
          <div class="wwd-icon" style="--c:#8075ff;--cd:rgba(128,117,255,0.12)">🏸</div>
          <h3>Skill Development</h3>
          <p>Structured coaching from players trained under US National Head Coach Hendry (2023–2024).</p>
          <span class="wwd-tag">Beginner → Advanced</span>
        </div>
        <div class="wwd-card wwd-card-primary reveal d2">
          <div class="wwd-icon" style="--c:#ff8c42;--cd:rgba(255,140,66,0.12)">🤝</div>
          <h3>Inclusive Community</h3>
          <p>Open to all youth regardless of experience. A welcoming space where everyone belongs from day one.</p>
          <span class="wwd-tag">All Ages Welcome</span>
        </div>
        <div class="wwd-card reveal d3">
          <div class="wwd-icon" style="--c:#34d399;--cd:rgba(52,211,153,0.12)">🆓</div>
          <h3>Always Free</h3>
          <p>No fees. No hidden costs. Equipment is provided. The only thing you need to bring is yourself.</p>
          <span class="wwd-tag">Equipment Included</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════╗ -->
  <!--   PHOTO GALLERY                         -->
  <!-- ╚══════════════════════════════════════╝ -->
  <section class="gallery">
    <div class="container">
      <div class="section-intro reveal" style="text-align:center;align-items:center">
        <span class="label">On The Court</span>
        <h2>Badminton in action</h2>
      </div>
      <div class="photo-grid">
        <div class="photo-cell photo-tall reveal d1">
          <img src="/images/badminton-1.jpg" alt="Badminton player mid-swing" loading="lazy" />
          <div class="photo-overlay"></div>
        </div>
        <div class="photo-cell reveal d2">
          <img src="/images/badminton-2.jpg" alt="Badminton shuttlecock in flight" loading="lazy" />
          <div class="photo-overlay"></div>
        </div>
        <div class="photo-cell reveal d3">
          <img src="/images/badminton-3.jpg" alt="Badminton racket and court" loading="lazy" />
          <div class="photo-overlay"></div>
        </div>
        <div class="photo-cell photo-wide reveal d4">
          <img src="/images/badminton-4.jpg" alt="Badminton doubles match" loading="lazy" />
          <div class="photo-overlay"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════╗ -->
  <!--   TESTIMONIALS                          -->
  <!-- ╚══════════════════════════════════════╝ -->
  <section class="testi">
    <div class="container">
      <div class="section-intro reveal" style="text-align:center;align-items:center">
        <span class="label">Testimonials</span>
        <h2>What people are saying</h2>
      </div>

      <div class="testi-grid">
        <blockquote class="tq reveal d1">
          <div class="tq-quote">"</div>
          <p>The coaches have an amazing ability to connect with children and make learning fun. My daughter can't stop talking about it.</p>
          <footer class="tq-footer">
            <div class="tq-av">ST</div>
            <div>
              <cite>Sarah Thompson</cite>
              <span>Parent</span>
            </div>
          </footer>
        </blockquote>

        <blockquote class="tq tq-hero reveal d2">
          <div class="tq-quote">"</div>
          <p>The quality of coaching, the organization, and the confidence my son has built are incredible. Highly recommend to anyone.</p>
          <footer class="tq-footer">
            <div class="tq-av">PN</div>
            <div>
              <cite>Priya Nair</cite>
              <span>Parent</span>
            </div>
          </footer>
        </blockquote>

        <blockquote class="tq reveal d3">
          <div class="tq-quote">"</div>
          <p>I was impressed by their maturity, organization, and professionalism. They teach beginners remarkably effectively.</p>
          <footer class="tq-footer">
            <div class="tq-av">KC</div>
            <div>
              <cite>Kim Collins</cite>
              <span>Principal, Carpenter Elementary</span>
            </div>
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════╗ -->
  <!--   CTA                                   -->
  <!-- ╚══════════════════════════════════════╝ -->
  <section class="cta-wrap">
    <div class="container">
      <div class="cta-card reveal scale-in">
        <div class="cta-orb cta-orb-a" aria-hidden="true"></div>
        <div class="cta-orb cta-orb-b" aria-hidden="true"></div>
        <div class="cta-body">
          <span class="label label-accent">Get Started Today</span>
          <h2>Ready to pick up a racket?</h2>
          <p>Sign up for notifications and be first to know when sessions open in Cary, NC. Spots fill fast.</p>
          <div class="cta-btns">
            <a href="/contact" class="btn btn-accent">Sign Up for Updates →</a>
            <a href="/faq" class="btn btn-ghost">Read the FAQ</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Ticker ───────────────────────────────────────────── */
  .ticker-wrap {
    overflow: hidden;
    background: var(--s1);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.875rem 0;
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .ticker-track {
    display: inline-flex;
    align-items: center;
    animation: ticker 30s linear infinite;
    white-space: nowrap;
    will-change: transform;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .ticker-inner { display: inline-flex; align-items: center; }

  .ti {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    padding: 0 1.5rem;
  }

  .td {
    color: var(--primary);
    font-size: 0.9rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  @keyframes ticker {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Stats ───────────────────────────────────────────── */
  .stats-section { background: var(--s1); border-bottom: 1px solid var(--border); }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .stat-card {
    background: var(--s2);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .stat-card:hover {
    border-color: var(--border-md);
    box-shadow: var(--sh);
    transform: translateY(-3px);
  }

  .stat-card-lit {
    background: linear-gradient(135deg, var(--s3), var(--s4));
    border-color: rgba(128,117,255,0.2);
    box-shadow: var(--sh-glow-p);
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
    background: linear-gradient(130deg, var(--text), var(--text-muted));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-card-lit .stat-num {
    background: linear-gradient(130deg, var(--primary-lt), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
  }

  .stat-label {
    font-size: 0.825rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .stat-bar {
    margin-top: 0.75rem;
    height: 3px;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    overflow: hidden;
  }

  .stat-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
    transition: transform 1.2s cubic-bezier(0.16,1,0.3,1) 0.5s;
  }

  /* stat-fill is inside .stat-card which is a .reveal — trigger on parent */
  .stat-card.in-view .stat-fill { transform: scaleX(1); }
  /* Fallback: also trigger when any ancestor has in-view */
  .in-view .stat-fill { transform: scaleX(1); }

  @media (max-width: 900px) { .stats-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 500px) { .stats-grid { grid-template-columns: 1fr; } }

  /* ── What We Do ──────────────────────────────────────── */
  .wwd { background: var(--bg); }

  .section-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 580px;
    margin-bottom: 3.5rem;
  }

  .section-intro h2 { margin-bottom: 0.875rem; }
  .section-intro p { color: var(--text-muted); font-size: 1.05rem; line-height: 1.75; }

  .wwd-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .wwd-card {
    background: var(--s1);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    transition: background 0.2s;
  }

  .wwd-card:hover { background: var(--s2); }

  .wwd-card-primary {
    background: linear-gradient(160deg, var(--s2), var(--s3));
    position: relative;
    overflow: hidden;
  }

  .wwd-card-primary::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
  }

  .wwd-icon {
    width: 52px; height: 52px;
    border-radius: var(--r);
    background: var(--cd);
    border: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
    box-shadow: 0 4px 16px var(--cd);
  }

  .wwd-card h3 { font-size: 1.1rem; }
  .wwd-card p { color: var(--text-muted); font-size: 0.925rem; line-height: 1.7; flex: 1; }

  .wwd-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) { .wwd-grid { grid-template-columns: 1fr; border-radius: var(--r-lg); } }

  /* ── Testimonials ─────────────────────────────────────── */
  .testi {
    background: var(--s1);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .testi-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .tq {
    background: var(--s2);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.25s;
  }

  .tq:hover {
    border-color: var(--border-md);
    box-shadow: var(--sh);
    transform: translateY(-4px);
  }

  .tq-hero {
    background: linear-gradient(160deg, var(--s3) 0%, var(--s4) 100%);
    border-color: rgba(128,117,255,0.2);
    box-shadow: var(--sh-glow-p);
  }

  .tq-quote {
    font-family: Georgia, serif;
    font-size: 3.5rem;
    line-height: 0.5;
    color: var(--primary);
    opacity: 0.4;
    font-weight: 700;
  }

  .tq p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.8; flex: 1; }
  .tq-hero p { color: var(--text); }

  .tq-footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .tq-av {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  cite {
    display: block;
    font-style: normal;
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--text);
  }

  .tq-footer span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) { .testi-grid { grid-template-columns: 1fr; } }

  /* ── Gallery ─────────────────────────────────────────── */
  .gallery {
    background: var(--s1);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: 260px 260px;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }

  .photo-tall { grid-row: span 2; }
  .photo-wide { grid-column: span 2; }

  .photo-cell {
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--s2);
  }

  .photo-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16,1,0.3,1), filter 0.4s;
    filter: brightness(0.85) saturate(0.9);
  }

  .photo-cell:hover img {
    transform: scale(1.06);
    filter: brightness(1) saturate(1.1);
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(8,8,15,0.6));
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .photo-cell:hover .photo-overlay { opacity: 0.5; }

  @media (max-width: 768px) {
    .photo-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 200px 200px 200px;
    }
    .photo-tall { grid-row: span 1; }
    .photo-wide { grid-column: span 2; }
  }

  @media (max-width: 480px) {
    .photo-grid { grid-template-columns: 1fr; grid-template-rows: repeat(4, 220px); }
    .photo-tall, .photo-wide { grid-row: span 1; grid-column: span 1; }
  }

  /* ── CTA ─────────────────────────────────────────────── */
  .cta-wrap { background: var(--bg); }

  .cta-card {
    background: linear-gradient(140deg, var(--s2) 0%, var(--s3) 50%, var(--s4) 100%);
    border: 1px solid rgba(128,117,255,0.2);
    border-radius: var(--r-xl);
    padding: 5rem 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: var(--sh-glow-p), var(--sh-lg);
  }

  .cta-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }

  .cta-orb-a {
    width: 400px; height: 400px;
    background: var(--primary);
    top: -200px; right: -100px;
    opacity: 0.12;
  }

  .cta-orb-b {
    width: 300px; height: 300px;
    background: var(--accent);
    bottom: -150px; left: -50px;
    opacity: 0.1;
  }

  .cta-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cta-body h2 { font-size: clamp(1.75rem, 3vw, 2.75rem); }

  .cta-body p {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 480px;
    line-height: 1.75;
  }

  .cta-btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.75rem;
  }

  @media (max-width: 600px) {
    .cta-card { padding: 3rem 1.5rem; }
  }
</style>
