---
import Layout from '../layouts/Layout.astro';

const workshops = [
  {
    id: 'workshop-tmsa',
    num: '02',
    title: 'TMSA Elementary Workshop',
    date: 'Mar – Apr 2026',
    location: 'TMSA Elementary',
    participants: 12,
    sessions: '5 weeks · 1 hr/session',
    skills: ['Overhead clears', 'Net play & drops', 'Footwork patterns'],
    highlight: 'Grew to 12 players across multiple grade levels. Our most diverse group to date.',
    upcoming: false,
    color: 'rgba(255,140,66,0.12)',
    border: 'rgba(255,140,66,0.28)',
  },
  {
    id: 'workshop-carpenter',
    num: '01',
    title: 'Carpenter Elementary Workshop',
    date: 'Sep – Oct 2025',
    location: 'Carpenter Elementary',
    participants: 10,
    sessions: '5 weeks · 1 hr/session',
    skills: ['Racket grip & stance', 'Basic serve & rally', 'Court movement'],
    highlight: 'Where it started. 10 beginners showed up and none had ever picked up a racket before.',
    upcoming: false,
    color: 'rgba(128,117,255,0.15)',
    border: 'rgba(128,117,255,0.3)',
  },
];

const tournaments = [
  {
    name: 'Community Smash',
    date: 'February 21, 2026',
    type: 'Singles & Doubles',
    partner: 'ShuttleZone',
    venue: 'Peak Sports Morrisville',
    raised: '$150',
    players: 200,
    desc: 'A community tournament at Peak Sports Morrisville, run in partnership with ShuttleZone. Players of all levels competed in singles and doubles, bringing together over 200 participants from across the Cary and Morrisville area.',
    color: 'rgba(128,117,255,0.12)',
    border: 'rgba(128,117,255,0.28)',
  },
];

const camps = [
  {
    id: 'camp-vibha',
    name: 'Summer Camp — Vibha Partnership',
    date: 'Summer 2026',
    partner: 'Vibha',
    photo: '/images/Screenshot%202026-06-18%20180200.png',
    desc: 'A full week of 3-hour sessions in partnership with Vibha, focused on full game strategy, advanced drills, and competitive scrimmages.',
    color: 'rgba(107,95,232,0.12)',
    border: 'rgba(107,95,232,0.28)',
  },
  {
    id: 'camp-rr-2',
    name: 'Rookie Rackets Summer Camp 2',
    date: 'Summer 2026',
    partner: 'Rookie Rackets',
    photo: '/images/camp2-1.jpg',
    desc: 'Our second Rookie Rackets summer camp, building on fundamentals with more game play and technique work.',
    color: 'rgba(240,120,48,0.1)',
    border: 'rgba(240,120,48,0.28)',
  },
  {
    id: 'camp-rjourney',
    name: 'RJourney Summer Camp',
    date: 'Summer 2026',
    partner: 'RJourney',
    photo: '/images/rjourney-1.jpg',
    desc: 'A summer camp run in partnership with RJourney, introducing more kids to the sport.',
    color: 'rgba(52,199,120,0.1)',
    border: 'rgba(52,199,120,0.28)',
  },
];

const eventTimeline = [
  { date: 'Sep – Oct 2025', name: 'Carpenter Elementary' },
  { date: 'Feb 21, 2026',   name: 'Community Smash' },
  { date: 'Mar – Apr 2026', name: 'TMSA Elem.' },
  { date: 'Apr 25, 2026', name: 'Vibha Pickleball Tournament' },
  { date: 'May 3, 2026',  name: 'Anurag Spring Walk/Run' },
  { date: 'Jul 20, 2026', name: 'VIBHA RR Camp' },
  { date: 'Aug 3, 2026',  name: 'RR Camp' },
  { date: 'Aug 10, 2026', name: 'RR & RJourney at Peak Sports' },
  { date: 'Aug 23, 2026', name: 'Vibha DreamMile' },
  { date: 'Aug 28, 2026', name: 'Raleigh Boys Club' },
];

const scheduleItems = [
  { label: 'Frequency', value: 'Every 6–8 weeks', icon: '📅' },
  { label: 'Day', value: 'Typically weekends', icon: '🗓️' },
  { label: 'Time', value: 'Timing varies', icon: '⏰' },
  { label: 'Duration', value: '1–2 hours per session', icon: '⏱️' },
  { label: 'Location', value: 'Cary, NC 27519', icon: '📍' },
  { label: 'Notice', value: 'Sign up to get email alerts', icon: '🔔' },
];
---

<Layout title="Completed Events" description="Past Rookie Rackets workshops, camps, and fundraising tournaments in Cary, NC — everything we've run since 2025.">

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true">
      <div class="ph-photo" style="background-image:url('/images/workshop-session.png')"></div>
      <div class="ph-orb" style="width:700px;height:700px;top:-30%;right:-8%;background:radial-gradient(ellipse at center,rgba(128,117,255,0.22) 0%,rgba(128,117,255,0.05) 45%,transparent 70%);animation-delay:0s"></div>
      <div class="ph-orb" style="width:420px;height:420px;bottom:-15%;left:-5%;background:radial-gradient(ellipse at center,rgba(255,140,66,0.16) 0%,transparent 65%);animation-delay:-6s"></div>
      <div class="ph-grid"></div>
    </div>
    <div class="container page-hero-inner">
      <span class="label reveal">Our Journey</span>
      <h1 class="reveal d1">Sessions, tournaments,<br /><span class="grad">and everything since 2025.</span></h1>
      <p class="page-hero-lead reveal d2">
        Two workshops, one tournament, and a program that keeps growing. Plus when to expect the next session.
      </p>
      <div class="page-hero-actions reveal d3">
        <a href="/contact" class="btn btn-primary">Join the Waitlist →</a>
        <a href="#schedule" class="btn btn-ghost">View Schedule</a>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <div class="stats-bar">
    <div class="container stats-bar-inner">
      {[
        { num: '60', label: 'Kids coached' },
        { num: '2', label: 'Workshops' },
        { num: '3', label: 'Camps' },
        { num: '1', label: 'Tournament' },
        { num: '$2,315', label: 'Raised' },
      ].map(s => (
        <div class="sbar-item reveal">
          <span class="sbar-num">{s.num}</span>
          <span class="sbar-label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Event Timeline -->
  <section class="etl-section">
    <div class="container">
      <div class="reveal" style="margin-bottom:2.5rem">
        <h2>Event Timeline</h2>
        <p class="section-lead">Every workshop, camp, and tournament we&rsquo;ve run &mdash; in the order they happened.</p>
      </div>
    </div>

    <div class="etl-scroll reveal d1">
      <div class="etl-track">
        {eventTimeline.map((e, i) => (
          <div class={`etl-col ${i % 2 === 0 ? 'up' : 'down'}`}>
            <span class="etl-dot"></span>
            <div class="etl-lbl">
              <div class="etl-date">{e.date}</div>
              <div class="etl-name">{e.name}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Past Workshops -->
  <section class="workshops-section">
    <div class="container">
      <div class="reveal" style="margin-bottom:3rem">
        <h2>Workshops</h2>
        <p class="section-lead">10 beginners at Carpenter Elementary, 12 at TMSA Elementary. Every session, documented below.</p>
      </div>

      <div class="workshop-list">
        {workshops.map((w, i) => (
          <div id={w.id} class={`workshop-card reveal d${i + 1}`} style={`--wc:${w.color};--wb:${w.border}`}>
            <div class="wcard-num">#{w.num}</div>
            <div class="wcard-main">
              <div class="wcard-header">
                <div>
                  <h3>{w.title}</h3>
                  <div class="wcard-meta">
                    <span>📅 {w.date}</span>
                    <span>📍 {w.location}</span>
                    <span>⏱ {w.sessions}</span>
                    <span>👥 {w.participants} participants</span>
                  </div>
                </div>
                {w.upcoming
                  ? <div class="wcard-badge wcard-badge-upcoming">Upcoming</div>
                  : <div class="wcard-badge">{w.participants} players</div>
                }
              </div>
              <p class="wcard-highlight">"{w.highlight}"</p>
              <div class="wcard-skills">
                {w.skills.map(s => (
                  <span class="skill-tag">{s}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Camps -->
  <section class="camps-section">
    <div class="container">
      <div class="reveal" style="margin-bottom:3rem">
        <h2>Camps</h2>
        <p class="section-lead">Multi-day summer camps run with our partners, going deeper on strategy, drills, and game play.</p>
      </div>

      <div class="camp-grid">
        {camps.map((c, i) => (
          <div id={c.id} class={`camp-card reveal d${i + 1}`} style={`--cc:${c.color};--cb:${c.border}`}>
            <div class="camp-photo" style={`background-image:url('${c.photo}')`} aria-hidden="true"></div>
            <div class="camp-main">
              <h3>{c.name}</h3>
              <div class="camp-meta">
                <span>📅 {c.date}</span>
                <span>🤝 w/ {c.partner}</span>
              </div>
              <p class="camp-desc">{c.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fundraising Tournaments -->
  <section class="tournaments-section">
    <div class="container">
      <div class="reveal" style="margin-bottom:3rem">
        <h2>How we fund the mission</h2>
        <p class="section-lead">Our camps and community tournaments do double duty: they teach the sport and raise the funds that keep every workshop free.</p>
      </div>

      <div class="tournament-grid">
        {tournaments.map((t, i) => (
          <div class={`t-card reveal d${i + 1}`} style={`--tc:${t.color};--tb:${t.border}`}>
            <div class="t-card-top">
              <div>
                <span class="t-type">{t.type}</span>
                <h3>{t.name}</h3>
                <div class="t-meta">
                  <span>📅 {t.date}</span>
                  <span>📍 {t.venue}</span>
                  <span>🤝 w/ {t.partner}</span>
                </div>
              </div>
              <div class="t-raised">
                <span class="t-raised-num">{t.raised}</span>
                <span class="t-raised-label">raised</span>
              </div>
            </div>
            <p class="t-desc">{t.desc}</p>
            <div class="t-footer">
              <div class="t-stat">
                <span class="t-stat-num">{t.players}</span>
                <span class="t-stat-label">participants</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Event Schedule -->
  <section class="schedule-section" id="schedule">
    <div class="container">
      <div class="reveal" style="margin-bottom:3rem">
        <h2>When we run sessions</h2>
        <p class="section-lead">Sessions aren't on a fixed calendar yet. Sign up and we'll email you when the next one opens.</p>
      </div>

      <div class="schedule-layout">
        <div class="schedule-grid">
          {scheduleItems.map((item, i) => (
            <div class={`sch-item reveal d${i + 1}`}>
              <span class="sch-icon">{item.icon}</span>
              <div>
                <strong>{item.label}</strong>
                <span>{item.value}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="timeline reveal">
          <div class="tl-head">
            <h3>How sessions unfold</h3>
          </div>
          <ol class="tl-list">
            {[
              { step: 'Warm-up · Get moving', desc: 'Light footwork and dynamic stretching to loosen up.' },
              { step: 'Drills · Skills & technique', desc: '45–60 min of structured skill work, grouped by level.' },
              { step: 'Scrimmage · Real play', desc: 'Open games with coach feedback on the fly.' },
              { step: 'Wrap-up · Recap', desc: 'Q&A, recap, and what to work on next.' },
            ].map((tl, i) => (
              <li class="tl-item">
                <div class="tl-dot">{i + 1}</div>
                <div>
                  <strong>{tl.step}</strong>
                  <p>{tl.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bottom-cta">
    <div class="container">
      <div class="bottom-cta-card reveal scale-in">
        <div class="bottom-cta-orb bottom-cta-orb-a" aria-hidden="true"></div>
        <div class="bottom-cta-orb bottom-cta-orb-b" aria-hidden="true"></div>
        <div class="bottom-cta-body">
          <span class="label label-accent">Don't Miss the Next One</span>
          <h2>Join the waitlist today</h2>
          <p>We'll email you when the next session is announced. No spam.</p>
          <div class="bottom-cta-btns">
            <a href="/contact" class="btn btn-accent">Sign Up for Updates →</a>
            <a href="/events" class="btn btn-ghost">View Upcoming Events</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  function initHistoryHighlight() {
    const hash = window.location.hash;
    if (!hash) return;
    const card = document.querySelector(hash);
    if (!card || !(card.classList.contains('workshop-card') || card.classList.contains('camp-card'))) return;

    setTimeout(() => {
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card.classList.add('card-highlighted');
      setTimeout(() => card.classList.remove('card-highlighted'), 2400);
    }, 350);
  }

  document.addEventListener('astro:page-load', initHistoryHighlight);
</script>

<style>
  /* Stats bar */
  .stats-bar {
    background: var(--s1);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 2.25rem 0;
  }

  .stats-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 2rem;
    flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .stats-bar-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 1rem;
      justify-items: center;
    }
  }

  .sbar-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    text-align: center;
  }

  .sbar-num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--primary);
  }

  .sbar-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  /* Shared section lead */
  .section-lead {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
    max-width: 540px;
    margin-top: 0.75rem;
  }

  /* Event Timeline */
  .etl-section { background: var(--bg); border-top: 1px solid var(--border); }

  .etl-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-inline: max(1.5rem, calc((100vw - var(--max)) / 2));
    -webkit-overflow-scrolling: touch;
  }

  .etl-track {
    position: relative;
    display: flex;
    min-width: 1480px;
    height: 236px;
  }

  .etl-track::before {
    content: '';
    position: absolute;
    left: 0; right: 0;
    top: 116px;
    height: 3px;
    border-radius: 2px;
    background: var(--border-md);
  }

  .etl-col { flex: 1; position: relative; }

  .etl-dot {
    position: absolute;
    left: 50%;
    top: 117px;
    transform: translate(-50%, -50%);
    width: 16px; height: 16px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 5px var(--primary-dim);
    z-index: 1;
  }

  .etl-lbl { position: absolute; left: 6px; right: 6px; text-align: center; }
  .etl-col.up   .etl-lbl { bottom: 134px; }
  .etl-col.down .etl-lbl { top: 134px; }

  .etl-lbl::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 2px; height: 12px;
    background: var(--border-md);
  }
  .etl-col.up   .etl-lbl::after { top: 100%; margin-top: 4px; }
  .etl-col.down .etl-lbl::after { bottom: 100%; margin-bottom: 4px; }

  .etl-date {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--primary);
    margin-bottom: 0.4rem;
    white-space: nowrap;
  }

  .etl-name {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
  }

  @media (max-width: 860px) {
    .etl-scroll { overflow: visible; padding-inline: 1.5rem; }
    .etl-track { min-width: 0; flex-direction: column; height: auto; }
    .etl-track::before { top: 6px; bottom: 6px; left: 8px; right: auto; width: 2px; height: auto; }
    .etl-col { flex: none; padding: 0 0 1.75rem 2.25rem; }
    .etl-dot { left: 9px; top: 9px; }
    .etl-lbl { position: static; text-align: left; }
    .etl-col.up .etl-lbl, .etl-col.down .etl-lbl { top: auto; bottom: auto; }
    .etl-lbl::after { display: none; }
    .etl-date { font-size: 0.875rem; }
    .etl-name { font-size: 1rem; }
  }

  /* Past Workshops */
  .workshops-section { background: var(--bg); border-top: 1px solid var(--border); }

  .workshop-list { display: flex; flex-direction: column; gap: 1.25rem; }

  .workshop-card {
    background: var(--s1);
    border: 1px solid var(--wb, var(--border));
    border-radius: var(--r-xl);
    padding: 2rem 2.25rem;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.75rem;
    align-items: start;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .workshop-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--wc, transparent);
    pointer-events: none;
  }

  .workshop-card:hover { transform: translateX(6px); box-shadow: var(--sh); }

  .workshop-card.card-highlighted {
    border-color: rgba(117,104,240,0.55) !important;
    box-shadow: 0 0 0 3px rgba(117,104,240,0.18), 0 0 40px rgba(117,104,240,0.22), var(--sh) !important;
    transform: translateX(6px) !important;
    animation: cardFlash 0.6s ease-out;
  }

  @keyframes cardFlash {
    0%   { box-shadow: 0 0 0 6px rgba(117,104,240,0.4), 0 0 60px rgba(117,104,240,0.35); }
    100% { box-shadow: 0 0 0 3px rgba(117,104,240,0.18), 0 0 40px rgba(117,104,240,0.22), var(--sh); }
  }

  .wcard-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-subtle);
    position: relative;
    line-height: 1;
    padding-top: 0.2rem;
  }

  .wcard-main { position: relative; }

  .wcard-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.875rem;
    flex-wrap: wrap;
  }

  .wcard-main h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }

  .wcard-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .wcard-badge {
    background: rgba(128,117,255,0.15);
    border: 1px solid rgba(128,117,255,0.25);
    border-radius: 999px;
    padding: 0.3rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary-lt);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .wcard-badge-upcoming {
    background: rgba(52,211,153,0.15);
    border-color: rgba(52,211,153,0.3);
    color: #34d399;
  }

  .wcard-highlight {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-style: italic;
    line-height: 1.7;
    margin-bottom: 1rem;
    background: rgba(128,117,255,0.07);
    border: 1px solid rgba(128,117,255,0.18);
    border-radius: var(--r-sm);
    padding: 0.7rem 1rem;
  }

  .wcard-skills { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .skill-tag {
    font-size: 0.72rem;
    font-weight: 600;
    background: var(--s2);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .workshop-card { grid-template-columns: 1fr; gap: 0.75rem; }
    .wcard-num { font-size: 1.1rem; }
  }

  /* Camps */
  .camps-section { background: var(--s1); border-top: 1px solid var(--border); }

  .camp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .camp-card {
    background: var(--s2);
    border: 1px solid var(--cb, var(--border));
    border-radius: var(--r-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.2s, box-shadow 0.2s;
    scroll-margin-top: 100px;
  }

  .camp-photo {
    height: 190px;
    background-size: cover;
    background-position: center;
    filter: brightness(0.96) saturate(1.02);
    transition: filter 0.3s;
    flex-shrink: 0;
  }

  .camp-card:hover .camp-photo { filter: brightness(1) saturate(1.08); }
  .camp-card:hover { transform: translateY(-4px); box-shadow: var(--sh); }

  .camp-card.card-highlighted {
    border-color: rgba(117,104,240,0.55) !important;
    box-shadow: 0 0 0 3px rgba(117,104,240,0.18), 0 0 40px rgba(117,104,240,0.22), var(--sh) !important;
    transform: translateY(-4px) !important;
    animation: cardFlash 0.6s ease-out;
  }

  .camp-main { padding: 1.5rem 1.75rem; }
  .camp-card h3 { font-size: 1.05rem; margin-bottom: 0.5rem; }
  .camp-meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.75rem; }
  .camp-desc { font-size: 0.9rem; color: var(--text-muted); line-height: 1.7; margin: 0; }

  /* Fundraising Tournaments */
  .tournaments-section {
    background: var(--s1);
    border-top: 1px solid var(--border);
  }

  .tournament-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 720px;
  }

  .t-card {
