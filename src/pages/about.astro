---
import Layout from '../layouts/Layout.astro';

const coaches = [
  {
    name: 'Adithya Burisetty',
    role: 'Founder & President',
    initials: 'AB',
    bio: 'Playing badminton for over seven years, Adithya founded Rookie Rackets to inspire kids to discover the joy of the sport and spread it through their communities. A Green Hope High School student, he turned a personal passion into a registered 501(c)(3) nonprofit.',
    extra: 'Specializes in singles strategy and footwork drills. Trained under US National Head Coach Hendry (2023–2024).',
    color: '#6b5fe8',
    photo: 'https://picsum.photos/seed/coach-adithya/400/320',
  },
  {
    name: 'Aarav Gupta',
    role: 'VP Programs',
    initials: 'AG',
    bio: 'Three years of competitive badminton and national tournament experience. Aarav leads program planning and ensures every workshop runs smoothly from start to finish, making sure every participant has a great time on the court.',
    extra: 'National tournament competitor. Specializes in doubles strategy and session planning.',
    color: '#f07830',
    photo: 'https://picsum.photos/seed/coach-aarav/400/320',
  },
  {
    name: 'Nikhil Peechara',
    role: 'VP Social Media',
    initials: 'NP',
    bio: 'Five years on the court learning skills and strategy. Nikhil manages all social media and community outreach for Rookie Rackets, focused on introducing badminton to neighborhoods where most people have never picked up a racket.',
    extra: 'Manages Instagram and outreach. Specializes in net play and drop shots.',
    color: '#34c778',
    photo: 'https://picsum.photos/seed/coach-nikhil/400/320',
  },
  {
    name: 'Nathan Kankanala',
    role: 'Senior Coach',
    initials: 'NK',
    bio: 'Started hitting in the backyard and never stopped. Six years of experience and a genuine love for the game that he brings to every session. Nathan has a gift for teaching beginners the fundamentals in a way that sticks.',
    extra: '6 years on the court. Specializes in beginner footwork and serve mechanics.',
    color: '#5a9fe8',
    photo: 'https://picsum.photos/seed/coach-nathan/400/320',
  },
  {
    name: 'Vihaan Darbha',
    role: 'Coach',
    initials: 'VD',
    bio: 'Picked up badminton during the pandemic and quickly reached #1 in the nation. Vihaan brings elite competitive energy to every workshop and wants younger players to find the same excitement and joy he discovered in the sport.',
    extra: '#1 national ranking. Specializes in smash technique and aggressive net play.',
    color: '#e84040',
    photo: 'https://picsum.photos/seed/coach-vihaan/400/320',
  },
  {
    name: 'Yuancheng Li',
    role: 'Coach',
    initials: 'YL',
    bio: 'Passionate about badminton and coaching in the NC area. Yuancheng brings energy and enthusiasm to every session, helping new players build confidence with every rally.',
    extra: 'Focused on building player confidence and consistency from the baseline.',
    color: '#d45028',
    photo: 'https://picsum.photos/seed/coach-yuancheng/400/320',
  },
  {
    name: 'Ishan Kanchi',
    role: 'Coach',
    initials: 'IK',
    bio: 'Ishan brings a patient, encouraging coaching style that makes beginners feel comfortable picking up a racket for the very first time.',
    extra: 'Known for patient, encouraging coaching. Specializes in working with first-time players.',
    color: '#8b5cf6',
    photo: 'https://picsum.photos/seed/coach-ishan/400/320',
  },
  {
    name: 'Tanay Kankanala',
    role: 'Coach',
    initials: 'TK',
    bio: 'Coming soon.',
    extra: 'Coming soon.',
    color: '#14b8a6',
    photo: '/images/tanay-kankanala.png',
  },
];

---

<Layout title="About" description="Learn about Rookie Rackets — who we are, our mission, and the coaches behind the program.">

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true">
      <div class="ph-photo" style="background-image:url('/images/our-team.jpg')"></div>
      <div class="ph-orb" style="width:700px;height:700px;top:-30%;right:-8%;background:radial-gradient(ellipse at center,rgba(107,95,232,0.14) 0%,rgba(107,95,232,0.04) 45%,transparent 70%);animation-delay:0s"></div>
      <div class="ph-orb" style="width:450px;height:450px;bottom:-15%;left:-5%;background:radial-gradient(ellipse at center,rgba(240,120,48,0.12) 0%,transparent 65%);animation-delay:-6s"></div>
      <div class="ph-grid"></div>
    </div>
    <div class="container page-hero-inner">
      <h1 class="reveal d1 ph-heading">
        <span class="ph-line-top">Built by high school students.</span>
        <span class="grad ph-line-bottom">Free for everyone.</span>
      </h1>
      <p class="page-hero-lead reveal d2">We're a badminton nonprofit based in NC. Elite coaching, no cost, all ages.</p>
    </div>
  </section>

  <!-- Our Story -->
  <section class="origin">
    <div class="container origin-inner">
      <div class="origin-text reveal from-left">
        <div class="origin-eyebrow">Our Story</div>
        <h2>A student's idea<br /><span class="grad">became a nonprofit.</span></h2>
        <p>A Green Hope High School student who is passionate about badminton wanted to make the sport more accessible in a community where several people either don't know it or do not get a chance to try it. What began in summer 2024 as one person's effort has grown into a team of 8 passionate high schoolers and a registered 501(c)(3) nonprofit, built on the belief that everyone should have the option to pick up a racket and see how fun the sport can be.</p>
        <p>Our goal is to keep widening that door, reaching more folks — all ages and abilities — across NC.</p>
        <a href="/events" class="btn btn-primary" style="margin-top:1rem">View Upcoming Events →</a>
      </div>
      <div class="origin-right reveal">
        <div class="origin-photo-wrap">
          <img src="/images/IMG_7504.jpeg" alt="Workshop in action" loading="lazy" class="origin-photo" />
          <div class="origin-photo-badge">
            <span class="opb-num">501(c)(3)</span>
            <span class="opb-label">Registered Nonprofit</span>
          </div>
        </div>
        <div class="op-card op-card-lit">
          <span class="op-icon">🎯</span>
          <div>
            <strong>Provide free, all-inclusive workshops</strong>
            <p>Sessions are open to anyone. No experience or cost required.</p>
          </div>
        </div>
        <div class="op-card">
          <span class="op-icon">🔥</span>
          <div>
            <strong>Inspire kids and adults to pursue the sport</strong>
            <p>Players of all ages leave the court excited about badminton.</p>
          </div>
        </div>
        <div class="op-card">
          <span class="op-icon">🌟</span>
          <div>
            <strong>Share the joy with our community</strong>
            <p>We're building something in NC that keeps growing with every new face we meet.</p>
          </div>
        </div>
        <div class="op-card">
          <span class="op-icon">🧠</span>
          <div>
            <strong>Psychologist-informed teaching</strong>
            <p>Coach Mark, a practicing psychologist, shapes how we teach so kids stay engaged and keep learning.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="mv-section">
    <div class="container mv-grid">
      <div class="mv-card mv-mission reveal from-left">
        <span class="mv-eyebrow">Mission</span>
        <h3>Share our love of badminton with the community.</h3>
        <p>We provide free, all-inclusive workshops and demonstration sessions for players of every age, any ability, and any skill level, welcoming anyone who wants to pick up a racket for the first time.</p>
      </div>
      <div class="mv-card mv-vision reveal">
        <span class="mv-eyebrow">Vision</span>
        <h3>Badminton for everyone — every age, every ability, every background.</h3>
        <p>A community where anyone can pick up a racket and fall in love with badminton, regardless of age, ability, or experience.</p>
      </div>
    </div>
  </section>

  <!-- Coaches Background -->
  <section class="coaches">
    <div class="container">
      <div class="coaches-layout">
        <div class="reveal from-left">
          <h2>Coaching Background</h2>
        </div>
        <div class="coaches-body reveal">
          <p>Our coaches bring serious competitive experience and a love for teaching. We have won $1,000+ in open competitions.</p>
          <p>Elite training paired with six years of beginner-first coaching. That combination is rare and comes in handy while coaching.</p>
          <p class="mentors-heading">Our Coaches and Mentors include:</p>
          <div class="mentor-tiles">
            <div class="mentor-tile">
              <img src="/images/coach-hendry.avif" alt="Coach Hendry, US National Head Coach" class="mentor-photo" loading="lazy" />
              <div class="mentor-info">
                <strong>Coach Hendry</strong>
                <span>US National Head Coach (2023–2024)</span>
              </div>
            </div>
            <div class="mentor-tile">
              <img src="/images/coach-mark.avif" alt="Coach Mark Chandler, Coach and Psychiatrist" class="mentor-photo" loading="lazy" />
              <div class="mentor-info">
                <strong>Coach Mark Chandler</strong>
                <span>Coach &amp; Psychiatrist</span>
              </div>
            </div>
          </div>
          <div class="badge-row">
            <span class="badge">🏆 US National Coach trained</span>
            <span class="badge">🏸 6+ yrs beginner coaching</span>
          </div>
        </div>
        <div class="coaches-photo reveal">
          <img src="/images/IMG_7486.jpeg" alt="Coaches leading a Rookie Rackets badminton session" loading="lazy" class="coaches-photo-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="team">
    <div class="container">
      <div class="reveal" style="margin-bottom:2.5rem">
        <h2>Meet the coaches</h2>
        <p class="team-sub">Eight coaches, all volunteers, all here because they love the sport.</p>
      </div>
      <p class="flip-hint">Tap any card to learn more</p>
      <div class="team-grid">
        {coaches.map(({ name, role, initials, bio, extra, color, photo }, i) => (
          <div class={`coach-outer reveal d${(i % 3) + 1}`} onclick="this.classList.toggle('flipped')" role="button" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' ')this.classList.toggle('flipped')">
            <div class="coach-inner">
              <!-- FRONT -->
              <div class="coach-face coach-front">
                <div class="coach-photo-wrap">
                  <img src={photo} alt={`Photo of ${name}`} class="coach-photo" loading="lazy" />
                  <div class="coach-photo-overlay" style={`background: linear-gradient(to top, ${color}cc 0%, ${color}44 50%, transparent 100%);`}></div>
                  <div class="coach-front-info">
                    <strong class="coach-name">{name}</strong>
                    <span class="coach-role">{role}</span>
                  </div>
                  <span class="coach-flip-hint">Tap to flip ↩</span>
                </div>
              </div>
              <!-- BACK -->
              <div class="coach-face coach-back" style={`background: linear-gradient(145deg, ${color}18, ${color}08);`}>
                <div class="coach-back-avatar" style={`background: linear-gradient(135deg, ${color}33, ${color}55); border: 2px solid ${color}55; color: ${color};`}>
                  {initials}
                </div>
                <strong class="coach-name">{name}</strong>
                <span class="coach-role" style={`color: ${color};`}>{role}</span>
                <p class="coach-bio">{bio}</p>
                <div class="coach-extra" style={`border-color: ${color}44; color: ${color};`}>
                  <span class="coach-extra-icon">✦</span> {extra}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="values">
    <div class="container">
      <div class="reveal" style="margin-bottom:2.5rem">
        <h2>What we stand for</h2>
      </div>
      <div class="val-grid">
        <div class="val reveal d1">
          <div class="val-icon">♿</div>
          <h3>Accessibility</h3>
          <p>Workshops are free. Equipment provided.</p>
        </div>
        <div class="val val-dark reveal d2">
          <div class="val-icon">🌍</div>
          <h3>Inclusion</h3>
          <p>Open to players of all ages and all abilities.</p>
        </div>
        <div class="val reveal d3">
          <div class="val-icon">⭐</div>
          <h3>Excellence</h3>
          <p>We bring the same focus to our workshops and camps that we bring to competition.</p>
        </div>
        <div class="val val-dark reveal d4">
          <div class="val-icon">🤝</div>
          <h3>Community</h3>
          <p>We're building a badminton community in Cary.</p>
        </div>
      </div>

      <div class="wellbeing-note reveal">
        <span class="wb-icon">🧠</span>
        <p><strong>More than a sport.</strong> Getting on the court builds more than fitness. Staying physically active is one of the most reliable ways to support mental health, and the game grows confidence, focus, and resilience along the way. We coach the whole player, not just the shot.</p>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bottom-cta">
    <div class="container">
      <div class="bottom-cta-card reveal scale-in">
        <div class="bottom-cta-orb bottom-cta-orb-a" aria-hidden="true"></div>
        <div class="bottom-cta-orb bottom-cta-orb-b" aria-hidden="true"></div>
        <div class="bottom-cta-body">
          <span class="label label-accent">Get Started Today</span>
          <h2>Ready to pick up a racket?</h2>
          <p>Sign up and we'll email you when sessions open in Cary, NC.</p>
          <div class="bottom-cta-btns">
            <a href="/contact" class="btn btn-accent">Sign Up for Updates →</a>
            <a href="/events" class="btn btn-ghost">View Events</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Crisper hero photo: drop the softening blur, add a touch of contrast/saturation */
  .page-hero .ph-photo {
    filter: brightness(0.72) contrast(1.06) saturate(1.05);
    transform: scale(1.04);
    background-position: center 22%;
  }

  /* Push hero copy toward the bottom so faces in the photo stay visible */
  .page-hero { align-items: flex-end; }
  /* Keep the intro sentence on one line on desktop */
  .page-hero-lead { max-width: none; }

  /* Split the hero headline: lift the first line, drop "Free for everyone." */
  .ph-line-top, .ph-line-bottom { display: block; }
  .ph-line-bottom { margin-top: clamp(3rem, 24vh, 230px); }
  @media (max-width: 600px) { .ph-line-bottom { margin-top: 2rem; } }

  /* ── Mission & Vision ────────────────────────── */
  .mv-section { background: var(--bg); border-top: 1px solid var(--border); }

  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 760px) { .mv-grid { grid-template-columns: 1fr; } }

  .mv-card {
    border-radius: var(--r-xl);
    padding: 2.25rem 2rem;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .mv-mission {
    background: linear-gradient(150deg, rgba(117,104,240,0.12), rgba(117,104,240,0.04));
    border-color: rgba(117,104,240,0.25);
  }
  .mv-vision {
    background: linear-gradient(150deg, rgba(240,120,48,0.1), rgba(240,120,48,0.03));
    border-color: rgba(240,120,48,0.25);
  }

  .mv-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary);
  }
  .mv-vision .mv-eyebrow { color: #c45c18; }
  .mv-card h3 { font-size: 1.2rem; line-height: 1.3; }
  .mv-card p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.75; margin: 0; }

  /* ── Well-being note (values section) ────────── */
  .wellbeing-note {
    margin-top: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    background: linear-gradient(135deg, rgba(52,199,120,0.1), rgba(52,199,120,0.03));
    border: 1px solid rgba(52,199,120,0.25);
    border-radius: var(--r-lg);
    padding: 1.5rem 1.75rem;
  }
  .wb-icon { font-size: 1.6rem; flex-shrink: 0; }
  .wellbeing-note p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.75; margin: 0; }
  .wellbeing-note strong { color: var(--text); }

  /* Keep the bottom-CTA sentence on one line on desktop */
  .bottom-cta-body p { max-width: 620px; }

  /* ── Our Story / Origin ──────────────────────── */
  .origin { background: var(--s1); border-top: 1px solid var(--border); }

  .origin-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  @media (max-width: 820px) { .origin-inner { grid-template-columns: 1fr; gap: 3rem; } }

  .origin-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }

  .origin-text h2 { margin-bottom: 1.5rem; }
  .origin-text p { color: var(--text-muted); font-size: 1.025rem; line-height: 1.8; margin-bottom: 1rem; }

  .origin-right { display: flex; flex-direction: column; gap: 1rem; }

  .origin-photo-wrap {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .origin-photo {
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
    filter: brightness(0.92) saturate(0.9);
    transition: filter 0.4s;
  }

  .origin-photo-wrap:hover .origin-photo { filter: brightness(1) saturate(1.05); }

  .origin-photo-badge {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: rgba(8,8,22,0.8);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(117,104,240,0.35);
    border-radius: var(--r);
    padding: 0.6rem 1rem;
    text-align: center;
  }

  .opb-num {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    color: #a89fff;
  }

  .opb-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(240,236,255,0.6);
    margin-top: 0.1rem;
  }

  .op-card {
    background: var(--s2);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .op-card:hover { border-color: var(--border-md); box-shadow: var(--sh); transform: translateX(5px); }

  .op-card-lit {
    background: linear-gradient(135deg, rgba(117,104,240,0.18), rgba(117,104,240,0.06));
    border-color: rgba(117,104,240,0.3);
    box-shadow: var(--sh-glow-p);
  }

  .op-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 0.1rem; }
  .op-card strong { display: block; font-size: 0.925rem; font-weight: 700; color: var(--text); margin-bottom: 0.3rem; }
  .op-card p { font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; margin: 0; }

  /* ── Coaching Background ─────────────────────── */
  .coaches { background: var(--s1); border-top: 1px solid var(--border); }

  .coaches-layout {
    display: grid;
    grid-template-columns: 240px 1fr 320px;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 1024px) { .coaches-layout { grid-template-columns: 240px 1fr; gap: 2.5rem; } }
  @media (max-width: 1024px) { .coaches-photo { display: none; } }
  @media (max-width: 820px)  { .coaches-layout { grid-template-columns: 1fr; gap: 2rem; } }

  .coaches-photo { position: relative; }

  .coaches-photo-img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    border-radius: var(--r-xl);
    display: block;
    box-shadow: var(--sh);
  }

  .coaches-layout h2 { font-size: 1.8rem; }
  .coaches-body p { color: var(--text-muted); font-size: 1rem; line-height: 1.8; margin-bottom: 1rem; }

  .badge-row { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-top: 1.5rem; }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--s2);
    border: 1px solid var(--border-md);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: border-color 0.15s, color 0.15s, transform 0.15s;
  }

  .badge:hover { border-color: var(--primary); color: var(--text); transform: translateY(-1px); }

  .mentors-heading { margin-top: 0.25rem !important; margin-bottom: 0.5rem !important; }
  .mentors-list {
    margin: 0 0 0.5rem;
    padding-left: 1.3rem;
    color: var(--text-muted);
  }
  .mentors-list li { font-size: 1rem; line-height: 1.7; margin-bottom: 0.35rem; }
  .mentors-list strong { color: var(--text); font-weight: 700; }

  .mentor-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0.5rem 0 0.25rem;
  }
  .mentor-tile {
    background: var(--s2);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .mentor-tile:hover { border-color: var(--border-md); transform: translateY(-3px); box-shadow: var(--sh); }
  .mentor-photo {
    width: 100%;
    height: 190px;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }
  .mentor-info { padding: 0.8rem 1rem; }
  .mentor-info strong { display: block; color: var(--text); font-size: 0.95rem; }
  .mentor-info span { display: block; color: var(--text-muted); font-size: 0.8rem; margin-top: 0.2rem; }
  @media (max-width: 480px) { .mentor-tiles { grid-template-columns: 1fr; } }

  /* ── Team ────────────────────────────────────── */
  .team { background: var(--bg); border-top: 1px solid var(--border); }

  .team-sub {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .flip-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    text-align: center;
    letter-spacing: 0.03em;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) { .team-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .team-grid { grid-template-columns: 1fr; } }

  /* ── Flip card ──────────────────────────────── */
  .coach-outer {
    perspective: 1000px;
    height: 400px;
    cursor: pointer;
    outline: none;
  }

  .coach-outer:focus-visible .coach-inner {
    box-shadow: 0 0 0 3px var(--primary);
  }

  .coach-inner {
    position: relative;
    width: 100%;
